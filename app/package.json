{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "//": "After making changes, run `bun run check` (oxlint + @shadcn/lint, then tsc) and fix all errors.",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build && rm -rf .next/standalone/.next/static && cp -R .next/static .next/standalone/.next/static",
    "start": "bun .next/standalone/server.js",
    "lint": "bun --bun oxlint",
    "typecheck": "bun --bun tsc --noEmit",
    "check": "bun run lint && bun run typecheck",
    "generate:assets": "./scripts/generate-inochi-assets.sh",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@emoji-mart/data": "1.2.1",
    "@emoji-mart/react": "1.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "16.31.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@shadcn/lint": "0.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.83.0",
    "react-doctor": "0.9.14",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "ignoreScripts": [
    "sharp"
  ],
  "trustedDependencies": [
    "sharp"
  ]
}
